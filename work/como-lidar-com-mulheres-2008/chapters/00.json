      "id": "00-0022",
      "hash": "7642161c"
    },
    {
      "type": "heading",
      "text": "APONTAMENTOS SOBRE UM PERFIL COMPORTAMENTAL FEMININO NAS RELAÇÕES AMOROSAS COM O HOMEM",
      "pages": [
        3
      ],
      "style": {
        "font": "Times-Bold",
        "size": 10.7,
        "bold": true,
        "italic": false,
