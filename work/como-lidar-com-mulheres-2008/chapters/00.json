        "left": 183.8,
        "color": 0
      },
      "warnings": [],
      "id": "00-0009",
      "hash": "b3b0a10a"
    },
    {
      "type": "paragraph",
      "text": "artimanhas manipulatórias femininas - defesa emocional - sofrimento amoroso - paixão - masculinidade",
